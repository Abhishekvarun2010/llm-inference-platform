aws_region  = "ap-southeast-2"
aws_profile = "application-deployer"
environment = "dev"

network_state_bucket = "llm-inference-platform-tfstate-248471876315-ap-southeast-2"
network_state_key    = "llm-inference-platform/dev/network/terraform.tfstate"
network_state_region = "ap-southeast-2"

# Replace with the public CIDR of the network that administers the cluster.
cluster_endpoint_public_access_cidrs = ["203.0.113.10/32"]

node_instance_types = ["t3.medium"]
node_min_size       = 2
node_desired_size   = 2
node_max_size       = 4

inference_base_url = "http://ollama.ollama.svc.cluster.local:11434/v1"
inference_model    = "qwen3:0.6b"

tags = {
  Owner = "platform-team"
}

